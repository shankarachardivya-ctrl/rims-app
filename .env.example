# ─── Google integration ──────────────────────────────────────────────────────
# The app reads and writes your Google Sheet directly. There is no Apps Script
# deployment: users sign in with Google and pick their workbook.
#
# See SETUP_GOOGLE.md for step-by-step instructions.

# OAuth 2.0 Web client ID — Cloud Console > APIs & Services > Credentials
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# API key — required by the Google Picker
VITE_GOOGLE_API_KEY=YOUR_API_KEY

# Cloud project NUMBER (not the project ID). Cloud Console > Home > Dashboard.
# The Picker needs this so files you select are granted to this app.
VITE_GOOGLE_PROJECT_NUMBER=123456789012
